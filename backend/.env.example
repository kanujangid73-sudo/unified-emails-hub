# Copy this file to .env and fill in the values you need. See docs/CONNECT_ACCOUNTS.md.

# "production" turns on startup checks: SECRET_KEY, ENCRYPTION_KEY, a Postgres DATABASE_URL and
# CORS_ORIGINS must be set, localhost origins are refused, and IMAP/SMTP servers must be public.
# APP_ENV=production

# Signs login tokens. Required in production; set it locally too, or logins reset on restart.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Encrypts stored mailbox passwords and OAuth tokens. Required in production.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first and keep the old one after a comma.
ENCRYPTION_KEY=

# "Sign in with Google" for Gmail (free: Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Sign in with Microsoft" for Outlook.com and Microsoft 365 (free: Entra app registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# AI summaries and reply drafts (only when a user clicks Summarize or Draft reply).
# Free key: https://aistudio.google.com/apikey  (free-tier prompts may be used by Google to
# improve its products). Without a key the app uses simple built-in summaries and templates.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# AI_REQUESTS_PER_HOUR=30

# Where the API and the web app run (OAuth redirects use these).
# PUBLIC_API_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173

# Defaults to a SQLite file. For Postgres (e.g. a free Neon database):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Allowed frontend URLs, comma-separated:
# CORS_ORIGINS=https://your-frontend.onrender.com

# Background sync
# SYNC_INTERVAL_SECONDS=300
# SYNC_BACKFILL_DAYS=30
# SYNC_SCHEDULER=true

# Limits
# SENDS_PER_HOUR=30
# GUEST_TTL_HOURS=24
# DEMO_LOGINS_PER_HOUR=10
